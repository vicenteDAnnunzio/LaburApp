# Frontend Environment Variables

# Adaptador de datos a usar: 'mock' o 'http'
# - 'mock': usa datos simulados en localStorage (para desarrollo sin backend)
# - 'http': conecta con un backend real
VITE_DATA_ADAPTER=http

# URL base de la API (solo se usa cuando VITE_DATA_ADAPTER=http)
# Ejemplo para desarrollo local con backend corriendo en puerto 4000
VITE_API_URL=http://localhost:4000
